#!/usr/bin/env python3
"""Launch Codex or Claude Code with a Research OS model route."""

from __future__ import annotations

import argparse
import json
import os
from collections.abc import Sequence

ROUTES: dict[tuple[str, str], tuple[str, ...]] = {
    ("codex", "control"): (
        "codex",
        "--model",
        "gpt-5.6-terra",
        "--config",
        'model_reasoning_effort="medium"',
    ),
    ("codex", "research"): (
        "codex",
        "--model",
        "gpt-5.6-sol",
        "--config",
        'model_reasoning_effort="high"',
    ),
    ("codex", "audit"): (
        "codex",
        "--model",
        "gpt-5.6-sol",
        "--config",
        'model_reasoning_effort="xhigh"',
    ),
    ("claude", "control"): ("claude", "--model", "sonnet", "--effort", "medium"),
    ("claude", "research"): ("claude", "--model", "opus", "--effort", "high"),
    ("claude", "audit"): ("claude", "--model", "opus", "--effort", "xhigh"),
}


def build_command(provider: str, route: str, extra: Sequence[str]) -> list[str]:
    command = list(ROUTES[(provider, route)])
    forwarded = list(extra)
    if forwarded[:1] == ["--"]:
        forwarded.pop(0)
    return [*command, *forwarded]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Launch a coding agent with a quality-aware Research OS model route."
    )
    parser.add_argument("provider", choices=("codex", "claude"))
    parser.add_argument("route", choices=("control", "research", "audit"))
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the exact argv as JSON instead of starting the agent",
    )
    args, extra = parser.parse_known_args()

    command = build_command(args.provider, args.route, extra)
    if args.dry_run:
        print(json.dumps(command, ensure_ascii=False))
        return 0
    os.execvp(command[0], command)
    return 127  # pragma: no cover - execvp replaces the process or raises


if __name__ == "__main__":
    raise SystemExit(main())
