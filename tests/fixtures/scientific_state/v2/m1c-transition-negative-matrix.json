{
  "schema_version": 2,
  "kind": "research_os.proposal_transition_negative_matrix",
  "observer_contract": {
    "case_id_is_display_only": true,
    "dispatch_fields": [
      "project_profiles.*.extends",
      "scenarios.*.extends",
      "documents.*.$doc",
      "documents.*.ref",
      "documents.*.derive.operation",
      "documents.*.patches[].op",
      "scenarios.*.steps[].driver",
      "scenarios.*.steps[].proposal.patches[].op",
      "invoke.driver",
      "invoke.arguments.proposal.patches[].op",
      "invoke.arguments.mutations[].op",
      "invoke.arguments.recompute[]",
      "invoke.paths[]"
    ],
    "allowed_patch_operations": ["add", "remove", "replace"],
    "forbidden_dispatch": ["case.id", "case.id prefix", "named Python case helper"],
    "assert_scenario_state_before_invoke": true,
    "resolution_order": [
      "project_profile_extends",
      "scenario_extends",
      "document_ref_or_literal_or_derive",
      "document_and_inline_patches",
      "document_recompute",
      "doc_ref_and_capture_ref",
      "invoke_mutations",
      "invoke_recompute",
      "path_ref_expansion"
    ],
    "resolution_semantics": {
      "extends": "Recursively resolve one named parent; deep-merge objects, append scenario steps, replace every other array, and reject cycles or unknown parents.",
      "$doc": "Resolve a named document to a deep copy; recursively resolve nested $doc values before applying local patches.",
      "$ref": "Resolve an exact dotted path from the matrix root to a deep copy and reject an unknown path.",
      "$capture": "Resolve an exact dotted path from a previously declared capture and reject forward or unknown references.",
      "patches": "Apply RFC-6901 add/remove/replace operations in listed order to a deep copy; never dispatch on case id.",
      "derive": "Execute only the declared generic operation and arguments after scenario materialization in an isolated non-persisting branch; select the declared payload and verify assert_derived before patches.",
      "mutations": "Apply the same RFC-6901 patch engine to the canonical base payload in listed order.",
      "recompute": "Recompute named canonical derived fields in listed dependency order, using the fully mutated payload; fields not listed remain byte-for-byte unchanged.",
      "control_assertions": "Evaluate the unpatched source document through the named production observer before using the derived or mutated document; assertion metadata is not part of the resolved payload."
    }
  },
  "defaults": {
    "zero_deltas": {
      "canonical_events": 0,
      "generation_events": 0,
      "baseline_events": 0,
      "registration_events": 0,
      "budget_attempts": 0,
